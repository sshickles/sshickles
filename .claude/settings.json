{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoMemoryEnabled": false,
  "env": {
    "REPO_STANDARD_IMPLEMENTER": "claude"
  },
  "permissions": {
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git push *--no-verify*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main)",
      "Bash(git push * *:main *)",
      "Bash(git push * refs/heads/main)",
      "Bash(git push * refs/heads/main *)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(git push * *:refs/heads/main *)"
    ]
  }
}
