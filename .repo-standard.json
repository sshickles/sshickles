{
  "version": 3,
  "repository": "sshickles/sshickles",
  "profile": "custom",
  "git": {
    "remote": "origin",
    "baseBranch": "main"
  },
  "validation": [
    [
      "actionlint"
    ],
    [
      "bash",
      "scripts/lint-shell"
    ],
    [
      "bash",
      "-n",
      "scripts/install-tools"
    ]
  ],
  "integrations": {
    "deploymentCheck": null,
    "greptile": true
  },
  "review": {
    "coderabbit": true
  },
  "development": {
    "environment": "none",
    "requiredFiles": [],
    "localCommands": [],
    "dependencies": {
      "lockfile": "mise.toml",
      "install": [
        "bash",
        "scripts/install-tools"
      ],
      "artifacts": [
        ".tools/actionlint"
      ]
    },
    "changedTestCommand": {
      "kind": "full",
      "reason": "Repository structure and canonical provenance validation requires the complete repository."
    },
    "fileChecks": [
      {
        "command": [
          "actionlint"
        ],
        "include": [
          ".github/workflows/*.yml",
          ".github/workflows/*.yaml"
        ]
      },
      {
        "command": [
          "bash",
          "-n"
        ],
        "include": [
          "*.sh",
          "scripts/install-tools"
        ],
        "perFile": true
      },
      {
        "command": [
          "python3",
          "-B",
          "-c",
          "import json, sys; [json.load(open(name)) for name in sys.argv[1:]]"
        ],
        "include": [
          "*.json"
        ]
      }
    ]
  },
  "facts": {
    "summary": "The owner's GitHub profile repository. GitHub shows the root README.md on the profile page.",
    "commands": [],
    "deployments": [
      {
        "name": "Profile page",
        "service": "GitHub",
        "environment": "production",
        "trigger": "merge to main",
        "url": "https://github.com/sshickles"
      }
    ],
    "backendFolders": [],
    "services": [
      {
        "name": "GitHub Actions",
        "purpose": "Runs the required checks job."
      },
      {
        "name": "Greptile",
        "purpose": "Reviews every PR; its approval is a required check."
      },
      {
        "name": "CodeRabbit",
        "purpose": "Reviewer behind ./scripts/review."
      },
      {
        "name": "Shields.io, streak-stats.demolab.com and komarev.com",
        "purpose": "Serve the badge, streak and view-count images embedded in README.md."
      }
    ],
    "plugins": [],
    "productRules": [],
    "coderabbitProfile": "ss"
  },
  "ciChecks": [
    {
      "context": "checks",
      "integration_id": 15368
    }
  ],
  "testCommand": [
    "python3",
    "-B",
    "scripts/standard.py",
    "validate",
    "."
  ]
}
