{
  "version": 2,
  "repository": "sshickles/sshickles",
  "profile": "custom",
  "git": {
    "remote": "origin",
    "baseBranch": "main"
  },
  "validation": [
    [
      "actionlint"
    ],
    [
      "bash",
      "scripts/lint-shell"
    ],
    [
      "bash",
      "-n",
      "scripts/install-tools"
    ]
  ],
  "integrations": {
    "deploymentCheck": null,
    "greptile": true
  },
  "review": {
    "coderabbit": true
  },
  "development": {
    "environment": "none",
    "requiredFiles": [],
    "localCommands": [],
    "dependencies": {
      "lockfile": "mise.toml",
      "install": [
        "bash",
        "scripts/install-tools"
      ],
      "artifacts": [
        ".tools/actionlint"
      ]
    },
    "changedTestCommand": {
      "kind": "full",
      "reason": "Repository structure and canonical provenance validation requires the complete repository."
    }
  },
  "conventions": {
    "branchPattern": "^(feat|fix|docs|chore|ci|refactor|prototype|research)/[a-z0-9]+(-[a-z0-9]+)*$",
    "issueReadiness": "No readiness label is required. See docs/agents/repository.md.",
    "claiming": "Check for an assignee or existing PR before starting; follow the destination issue policy."
  },
  "ciChecks": [
    {
      "context": "checks",
      "integration_id": 15368
    }
  ],
  "testCommand": [
    "python3",
    "-B",
    "scripts/repository.py",
    "validate",
    "."
  ]
}
